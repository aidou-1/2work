rules_version = '2';
// 2 WORK · règles de sécurité Firestore (clubs, séances partagées, chat).
// Principe : chacun ne lit que ce qui le concerne ; un club n'est visible que de ses membres ;
// seuls le coach et les co-coachs publient des séances, valident les demandes et modèrent.
// Chaque écriture est vérifiée champ par champ (liste fermée de champs, types, tailles) ;
// le pseudo écrit est toujours celui du compte (impossible de parler au nom d'un autre).
service cloud.firestore {
  match /databases/{db}/documents {
    function connecte() { return request.auth != null; }
    function moi() { return request.auth.uid; }
    function D() { return request.resource.data; }
    function membreDoc(c) { return /databases/$(db)/documents/clubs/$(c)/membres/$(moi()); }
    function membre(c) { return connecte() && exists(membreDoc(c)); }
    function role(c) { return get(membreDoc(c)).data.role; }
    function staff(c) { return membre(c) && role(c) in ['coach', 'cocoach']; }
    function coach(c) { return membre(c) && role(c) == 'coach'; }
    function seulement(l) { return D().diff(resource.data).affectedKeys().hasOnly(l); }
    function champs(oblig, permis) { return D().keys().hasAll(oblig) && D().keys().hasOnly(permis); }
    function texte(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
    function texteVide(s, max) { return s is string && s.size() <= max; }
    function monPseudo() { return get(/databases/$(db)/documents/profils/$(moi())).data.pseudo; }
    function maintenant(t) { return t == request.time; }
    function jour(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function id(s) { return s is string && s.matches('^[A-Za-z0-9_-]{1,40}$'); }
    // anti-spam du chat : 1 message toutes les 2 secondes au plus, pas de liens pour les simples membres, pas d'insultes
    function pasTropVite(c) { let avant = get(membreDoc(c)).data.get('dernier', null); return getAfter(membreDoc(c)).data.get('dernier', null) == request.time && (avant == null || request.time > avant + duration.value(2, 's')); }
    function sansLien(c, t) { return role(c) != 'membre' || !t.lower().matches('(?s).*(https?://|www[.]|[a-z0-9-]+[.](com|fr|net|org|io|ly|gg|me|xyz)/).*'); }
    function prevOk(p) { return p is map && p.keys().hasOnly(['on', 'sp', 'obj', 'vue', 'depuis']) && p.on is bool && p.sp is string && p.sp.matches('^[a-z]{2,12}$')
      && p.obj is int && p.obj >= 1 && p.obj <= 3 && p.vue in ['noms', 'total'] && jour(p.depuis); }
    function poli(t) { return !t.lower().matches('(?s)(.*[^a-z])?(connard|connasse|salope|salaud|pute|encul|ntm|nique ta|niquer ta|fdp|fils de pute|batard|bâtard|pédé|negre|nègre|bougnoul|youpin|bitch|fuck|motherf|cunt|nigg|faggot|retardé mental|suicide-toi|va te pendre).*'); }

    // compte privé : seulement soi (date de naissance, accord parental, liste de ses clubs)
    match /comptes/{uid} {
      allow read, delete: if connecte() && moi() == uid;
      allow create: if connecte() && moi() == uid && champs(['naissance', 'parental', 'cree', 'clubs', 'attente'], ['naissance', 'parental', 'cree', 'clubs', 'attente'])
        && jour(D().naissance) && D().parental is bool && maintenant(D().cree) && D().clubs == [] && D().attente == [];
      allow update: if connecte() && moi() == uid && seulement(['clubs', 'attente'])
        && D().clubs is list && D().clubs.size() <= 50 && D().attente is list && D().attente.size() <= 50;
    }
    // profil public : pseudo affiché dans les clubs et le chat (pas modifiable ensuite)
    match /profils/{uid} {
      allow read: if connecte();
      allow create: if connecte() && moi() == uid && champs(['pseudo'], ['pseudo']) && D().pseudo.matches('^[A-Za-z0-9_.-]{3,20}$')
        && getAfter(/databases/$(db)/documents/pseudos/$(D().pseudo.lower())).data.uid == uid;
      allow delete: if connecte() && moi() == uid;
    }
    // réservation des pseudos : un document par pseudo en minuscules, donc impossible d'avoir deux fois le même
    match /pseudos/{p} {
      allow get: if true;
      allow create: if connecte() && champs(['uid'], ['uid']) && D().uid == moi() && p.matches('^[a-z0-9_.-]{3,20}$')
        && getAfter(/databases/$(db)/documents/profils/$(moi())).data.pseudo.lower() == p;
      allow delete: if connecte() && resource.data.uid == moi();
    }

    // sauvegarde en ligne du suivi (facultative, sur consentement) : visible et modifiable par son propriétaire seul, 1 Mo maximum, 1 envoi par minute au plus
    match /sauvegardes/{uid} {
      allow read, delete: if connecte() && moi() == uid;
      allow create, update: if connecte() && moi() == uid && champs(['z', 'n', 't'], ['z', 'n', 't']) && D().z is bytes && D().z.size() <= 1000000
        && D().n is int && maintenant(D().t) && (resource == null || request.time > resource.data.t + duration.value(60, 's'));
    }

    match /clubs/{c} {
      allow read: if membre(c);
      allow create: if connecte() && champs(['nom', 'sport', 'desc', 'coach', 'cree'], ['nom', 'sport', 'desc', 'coach', 'cree'])
        && D().coach == moi() && texte(D().nom, 40) && texteVide(D().sport, 30) && texteVide(D().desc, 300) && maintenant(D().cree)
        && getAfter(/databases/$(db)/documents/clubs/$(c)/membres/$(moi())).data.role == 'coach';
      allow update: if staff(c) && seulement(['nom', 'sport', 'desc']) && texte(D().nom, 40) && texteVide(D().sport, 30) && texteVide(D().desc, 300)
        || (coach(c) && seulement(['prev']) && prevOk(D().prev));   // prévention des blessures : réglée par le coach seul (dont qui voit le détail)
      allow delete: if coach(c);

      // lien d'invitation : connaître le code (9 caractères aléatoires) suffit pour lire le nom du club et demander à entrer
      match /invits/{code} {
        allow get: if connecte();
        allow list, delete: if staff(c);
        allow create: if staff(c) && code.matches('^[a-z0-9]{9}$') && champs(['nom', 'cree'], ['nom', 'cree']) && texte(D().nom, 40) && maintenant(D().cree);
      }
      match /demandes/{uid} {
        allow read: if staff(c) || (connecte() && moi() == uid);
        allow create: if connecte() && moi() == uid && !exists(membreDoc(c)) && champs(['pseudo', 'code', 'nom', 't'], ['pseudo', 'code', 'nom', 't'])
          && D().pseudo == monPseudo() && texteVide(D().nom, 40) && maintenant(D().t) && id(D().code)
          && exists(/databases/$(db)/documents/clubs/$(c)/invits/$(D().code));
        allow delete: if staff(c) || (connecte() && moi() == uid);
      }
      match /membres/{uid} {
        allow read: if membre(c);
        // le créateur s'inscrit coach en créant le club ; ensuite seul le staff ajoute, et seulement quelqu'un qui l'a demandé
        allow create: if champs(['uid', 'pseudo', 'role', 'muet', 'depuis'], ['uid', 'pseudo', 'role', 'muet', 'depuis']) && D().uid == uid && D().muet == false && maintenant(D().depuis)
          && ((connecte() && moi() == uid && D().role == 'coach' && D().pseudo == monPseudo() && getAfter(/databases/$(db)/documents/clubs/$(c)).data.coach == uid)
            || (staff(c) && D().role == 'membre' && D().pseudo == get(/databases/$(db)/documents/clubs/$(c)/demandes/$(uid)).data.pseudo));
        // le coach nomme ou retire les co-coachs ; le staff rend muet ; personne ne touche au rôle du coach ni ne se modifie soi-même
        allow update: if (connecte() && moi() == uid && seulement(['dernier']) && maintenant(D().dernier))   // horodatage anti-spam, écrit avec chaque message
          || resource.data.role != 'coach' && uid != moi() && D().muet is bool && (!('motif' in D()) || texteVide(D().motif, 60))
          && ((coach(c) && seulement(['role', 'muet', 'motif']) && D().role in ['membre', 'cocoach'])
            || (staff(c) && resource.data.role == 'membre' && seulement(['muet', 'motif'])));
        // on peut partir ; le staff peut exclure un membre (un co-coach seulement par le coach) ; le coach part en dernier, club supprimé
        allow delete: if (resource.data.role != 'coach' && ((connecte() && moi() == uid) || coach(c) || (staff(c) && resource.data.role == 'membre')))
          || (connecte() && moi() == uid && !exists(/databases/$(db)/documents/clubs/$(c)));
      }
      // notice d'exclusion : le membre exclu lit le motif, puis l'efface (exposé des motifs, DSA art. 17)
      match /exclus/{uid} {
        allow read: if (connecte() && moi() == uid) || staff(c);
        allow create: if staff(c) && uid != moi() && champs(['motif', 'nom', 't'], ['motif', 'nom', 't']) && texte(D().motif, 60) && texteVide(D().nom, 40) && maintenant(D().t)
          && get(/databases/$(db)/documents/clubs/$(c)/membres/$(uid)).data.role != 'coach';
        allow delete: if (connecte() && moi() == uid) || staff(c);
      }
      match /seances/{s} {
        allow read: if membre(c);
        allow create, update: if staff(c) && champs(['titre', 'date', 'note', 'auteur', 'cree'], ['titre', 'date', 'note', 'auteur', 'cree', 'base', 'ids', 'prog'])
          && texte(D().titre, 60) && jour(D().date) && texteVide(D().note, 300) && D().auteur == moi()
          && (!('base' in D()) || id(D().base)) && (!('prog' in D()) || id(D().prog)) && (!('ids' in D()) || (D().ids is list && D().ids.size() <= 60));
        allow delete: if staff(c);
        match /faits/{uid} {
          allow read: if membre(c);
          allow create, update: if membre(c) && moi() == uid && champs(['pseudo', 't'], ['pseudo', 't']) && D().pseudo == monPseudo() && maintenant(D().t);
          allow delete: if (connecte() && moi() == uid) || staff(c);
        }
      }
      match /messages/{m} {
        function reac(e) {
          let avant = resource.data.reac.get(e, []);
          let apres = D().reac.get(e, []);
          return D().reac.diff(resource.data.reac).affectedKeys().hasOnly([e]) && apres is list && apres.size() == apres.toSet().size()
            && (apres.toSet() == avant.toSet().union([moi()].toSet()) || apres.toSet() == avant.toSet().difference([moi()].toSet()));
        }
        allow read: if membre(c);
        allow create: if membre(c) && get(membreDoc(c)).data.muet != true && champs(['uid', 'pseudo', 'texte', 't', 'reac'], ['uid', 'pseudo', 'texte', 't', 'reac', 'rep'])
          && D().uid == moi() && D().pseudo == monPseudo() && texte(D().texte, 1000) && maintenant(D().t) && D().reac == {}
          && pasTropVite(c) && sansLien(c, D().texte) && poli(D().texte)
          && (!('rep' in D()) || (D().rep is map && D().rep.keys().hasOnly(['m', 'pseudo', 'extrait']) && texteVide(D().rep.extrait, 80) && texteVide(D().rep.pseudo, 20)));
        // réactions : chacun ajoute ou retire seulement la sienne, parmi 5 emojis ; suppression (texte effacé) : l'auteur ou le staff
        allow update: if membre(c) && ((seulement(['reac']) && (reac('👍') || reac('❤️') || reac('💪') || reac('🔥') || reac('😂')))
          || (resource.data.uid == moi() && seulement(['suppr', 'texte']) && D().suppr == true && D().texte == '')
          || (staff(c) && seulement(['suppr', 'texte', 'motif']) && D().suppr == true && D().texte == '' && texte(D().motif, 60)));
        allow delete: if coach(c);   // seulement pour supprimer le club entier
      }
      // prévention : chacun écrit sa propre fiche de la semaine (+1 à chaque fois) ; le staff ne la lit que si le coach a choisi « nom par nom »
      match /prev/{p} {
        allow read: if (connecte() && resource.data.uid == moi())
          || (staff(c) && get(/databases/$(db)/documents/clubs/$(c)).data.get('prev', {}).get('vue', 'total') == 'noms');
        allow create: if membre(c) && champs(['uid', 'pseudo', 's', 'n', 't'], ['uid', 'pseudo', 's', 'n', 't']) && D().uid == moi() && jour(D().s)
          && p == D().s + '_' + moi() && D().pseudo == monPseudo() && D().n == 1 && maintenant(D().t);
        allow update: if membre(c) && resource.data.uid == moi() && seulement(['n', 't']) && D().n == resource.data.n + 1 && D().n <= 14 && maintenant(D().t);
        allow delete: if coach(c) || (connecte() && resource.data.uid == moi());
      }
      // total de l'équipe par semaine (lisible par tous les membres) : +1 séance, et +1 joueur à sa première fois de la semaine
      match /prevSem/{s} {
        allow read: if membre(c);
        allow create: if membre(c) && jour(s) && D().keys().hasOnly(['n', 'j']) && D().n == 1 && D().j == 1;
        allow update: if membre(c) && D().keys().hasOnly(['n', 'j']) && D().n == resource.data.n + 1 && (D().j == resource.data.j || D().j == resource.data.j + 1);
        allow delete: if coach(c);
      }
      match /signalements/{r} {
        allow read, delete: if staff(c);
        allow create: if membre(c) && champs(['m', 'extrait', 'auteur', 'par', 't'], ['m', 'extrait', 'auteur', 'par', 't']) && D().par == moi()
          && id(D().m) && texteVide(D().extrait, 200) && texteVide(D().auteur, 20) && maintenant(D().t);
      }
    }
    // compteurs anonymes (avec l'accord de l'utilisateur) : un total par jour et par événement, sans identifiant ;
    // on ne peut que l'augmenter de 1 à 20 à la fois, jamais le baisser, le remplacer ni le supprimer. Lecture libre : ce ne sont que des totaux.
    match /stats/{s} {
      allow read: if true;
      allow create: if s.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]_[a-z0-9_]{1,40}$') && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 20;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int
        && request.resource.data.n > resource.data.n && request.resource.data.n <= resource.data.n + 20;
    }
  }
}
