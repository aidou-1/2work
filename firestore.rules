rules_version = '2';
// 2 WORK · règles de sécurité Firestore (clubs, séances partagées, chat).
// Principe : chacun ne lit que ce qui le concerne ; un club n'est visible que de ses membres ;
// seuls le coach et les co-coachs publient des séances, valident les demandes et modèrent.
service cloud.firestore {
  match /databases/{db}/documents {
    function connecte() { return request.auth != null; }
    function moi() { return request.auth.uid; }
    function membreDoc(c) { return /databases/$(db)/documents/clubs/$(c)/membres/$(moi()); }
    function membre(c) { return connecte() && exists(membreDoc(c)); }
    function role(c) { return get(membreDoc(c)).data.role; }
    function staff(c) { return membre(c) && role(c) in ['coach', 'cocoach']; }
    function coach(c) { return membre(c) && role(c) == 'coach'; }
    function seulement(l) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(l); }
    function texte(s, max) { return s is string && s.size() > 0 && s.size() <= max; }

    // compte privé : seulement soi (date de naissance, accord parental)
    match /comptes/{uid} {
      allow read, delete: if connecte() && moi() == uid;
      allow create, update: if connecte() && moi() == uid && request.resource.data.keys().hasOnly(['naissance', 'parental', 'cree', 'clubs', 'attente']);
    }
    // profil public : pseudo affiché dans les clubs et le chat
    match /profils/{uid} {
      allow read: if connecte();
      allow create: if connecte() && moi() == uid && texte(request.resource.data.pseudo, 20)
        && getAfter(/databases/$(db)/documents/pseudos/$(request.resource.data.pseudo.lower())).data.uid == uid;
      allow update: if connecte() && moi() == uid && seulement(['couleur']);
      allow delete: if connecte() && moi() == uid;
    }
    // réservation des pseudos : un document par pseudo en minuscules, donc impossible d'avoir deux fois le même
    match /pseudos/{p} {
      allow get: if true;
      allow create: if connecte() && request.resource.data.uid == moi() && p.matches('^[a-z0-9_.-]{3,20}$');
      allow delete: if connecte() && resource.data.uid == moi();
    }

    match /clubs/{c} {
      allow read: if membre(c);
      allow create: if connecte() && request.resource.data.coach == moi() && texte(request.resource.data.nom, 40)
        && getAfter(/databases/$(db)/documents/clubs/$(c)/membres/$(moi())).data.role == 'coach';
      allow update: if staff(c) && seulement(['nom', 'sport', 'desc']);
      allow delete: if coach(c);

      // lien d'invitation : connaître le code suffit pour lire le nom du club et demander à entrer
      match /invits/{code} {
        allow get: if connecte();
        allow list, create, delete: if staff(c);
      }
      match /demandes/{uid} {
        allow read: if staff(c) || (connecte() && moi() == uid);
        allow create: if connecte() && moi() == uid && !exists(membreDoc(c)) && texte(request.resource.data.pseudo, 20)
          && exists(/databases/$(db)/documents/clubs/$(c)/invits/$(request.resource.data.code));
        allow delete: if staff(c) || (connecte() && moi() == uid);
      }
      match /membres/{uid} {
        allow read: if membre(c);
        // le créateur s'inscrit coach en créant le club ; ensuite seul le staff ajoute, et seulement des membres
        allow create: if (connecte() && moi() == uid && request.resource.data.role == 'coach' && getAfter(/databases/$(db)/documents/clubs/$(c)).data.coach == uid)
          || (staff(c) && request.resource.data.role == 'membre' && exists(/databases/$(db)/documents/clubs/$(c)/demandes/$(uid)));
        // le coach nomme ou retire les co-coachs ; le staff rend muet ; personne ne touche au rôle du coach
        allow update: if resource.data.role != 'coach' && ((coach(c) && seulement(['role', 'muet']) && request.resource.data.role in ['membre', 'cocoach'])
          || (staff(c) && seulement(['muet'])));
        // on peut partir ; le staff peut exclure un membre ; le coach ne part qu'en supprimant le club
        allow delete: if resource.data.role != 'coach' && ((connecte() && moi() == uid) || staff(c))
          || (connecte() && moi() == uid && !exists(/databases/$(db)/documents/clubs/$(c)));   // le coach part en dernier, club supprimé
      }
      match /seances/{s} {
        allow read: if membre(c);
        allow create, update, delete: if staff(c);
        match /faits/{uid} {
          allow read: if membre(c);
          allow create, update: if membre(c) && moi() == uid;
          allow delete: if (connecte() && moi() == uid) || staff(c);
        }
      }
      match /messages/{m} {
        allow read: if membre(c);
        allow create: if membre(c) && get(membreDoc(c)).data.muet != true && request.resource.data.uid == moi()
          && texte(request.resource.data.texte, 1000) && request.resource.data.t == request.time;
        // réactions : n'importe quel membre ; suppression (texte effacé) : l'auteur ou le staff
        allow update: if membre(c) && (seulement(['reac'])
          || ((resource.data.uid == moi() || staff(c)) && seulement(['suppr', 'texte']) && request.resource.data.suppr == true && request.resource.data.texte == ''));
        allow delete: if coach(c);   // seulement pour supprimer le club entier
      }
      match /signalements/{r} {
        allow read, delete: if staff(c);
        allow create: if membre(c) && request.resource.data.par == moi();
      }
    }
  }
}
